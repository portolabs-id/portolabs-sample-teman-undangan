{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "teman-undangan",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "teman-undangan" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "teman-undangan-cache" },
    { "binding": "MEDIA", "bucket_name": "teman-undangan-media" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "teman-undangan", "database_id": "PLACEHOLDER_RUN_D1_CREATE" }
  ]
}
